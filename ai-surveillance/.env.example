# ==============================================================================
# ResQMesh AI Surveillance & Disaster Management Engine Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROQ AI DISASTER CHATBOT (Required for Groq Emergency Assistance)
# ------------------------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supported fast models:
#   - llama-3.3-70b-versatile (Recommended: best reasoning & speed)
#   - llama-3.1-8b-instant (Fastest, ultra low latency)
#   - mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. DISASTER API SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Server host and port for disaster_api_server.py
DISASTER_API_HOST=0.0.0.0
DISASTER_API_PORT=8800

# ------------------------------------------------------------------------------
# 3. BITCHAT MESH ALERTING & DISCOVERY
# ------------------------------------------------------------------------------
# IP address of Android device running BitChat mesh node on local WiFi / Hotspot
# Auto-discover via: python tools/bitchat_bridge/find_bitchat.py
BITCHAT_IP=10.108.31.151
BITCHAT_PORT=8765
BITCHAT_CHANNEL=surveillance

# ------------------------------------------------------------------------------
# 4. VISION LANGUAGE MODEL (VLM) SETTINGS
# ------------------------------------------------------------------------------
# Model ID: Qwen/Qwen2.5-VL-3B-Instruct (NF4 quantized)
# Disk offload directory if GPU VRAM is constrained:
VLM_OFFLOAD_DIR=./models/offload
VLM_DEBUG=0
USE_TF=0
ORT_LOGGING_LEVEL=3

# ------------------------------------------------------------------------------
# 5. SURVEILLANCE DETECTOR & SUBSYSTEM DEBUG FLAGS (0 = off, 1 = on)
# ------------------------------------------------------------------------------
DEBUG_DEVICE=0
FALL_DEBUG=0
FALL_DEBUG_LIMIT=10
PHONE_DEBUG=0
